{
    "name": "eloquage/beacon",
    "description": "Local semantic search for PHP: store embeddings, query top-k, and filter by metadata\u2014framework-agnostic.",
    "keywords": [
        "Eloquage",
        "beacon"
    ],
    "homepage": "https://github.com/eloquage/beacon",
    "license": "MIT",
    "authors": [
        {
            "name": "Miguel Enes",
            "email": "carlos.miguel.enes@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
        "pestphp/pest": "^5.2",
        "laravel/pint": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Eloquage\\Beacon\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Eloquage\\Beacon\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage --min=90",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
